    "def spectral_type_from_gr(g_r):\n",
    "    if g_r < -0.2:\n",
    "        return \"O/B\"\n",
    "    elif g_r < 0.0:\n",
    "        return \"A\"\n",
    "    elif g_r < 0.3:\n",
    "        return \"F\"\n",
    "    elif g_r < 0.6:\n",
    "        return \"G\"\n",
    "    elif g_r < 1.0:\n",
    "        return \"K\"\n",
    "    else:\n",
    "        return \"M\"\n",
    "    \n",
    "stars[\"spectral_type\"] = stars[\"g_r\"].apply(spectral_type_from_gr)\n",
    "\n",
    "order = [\"O/B\", \"A\", \"F\", \"G\", \"K\", \"M\"]\n",
    "\n",
    "stars[\"spectral_type\"] = pd.Categorical(\n",
    "    stars[\"spectral_type\"],\n",
    "    categories=order,\n",
    "    ordered=True\n",
    ")"
   ],
